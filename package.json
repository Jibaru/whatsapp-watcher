{
  "name": "whatsapp-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "sst dev --stage dev",
    "deploy": "sst deploy --stage dev",
    "destroy": "sst remove --stage dev",
    "secret:set": "sst secret set KapsoWebhookSecret --stage dev",
    "secret:openai": "sst secret set OpenAiApiKey --stage dev",
    "typecheck": "tsc --noEmit",
    "test": "bun test packages",
    "test:integration": "sst shell --stage dev -- bun test integration",
    "webhook:test": "bun packages/ingest/scripts/send-test-webhook.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1127.0",
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/client-lambda": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^24.13.3",
    "sst": "^4.17.1",
    "typescript": "^5.9.3"
  }
}
